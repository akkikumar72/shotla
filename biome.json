{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "files": {
    "includes": [
      "app/**",
      "lib/editor-model.ts",
      "hooks/use-shotla-editor.ts",
      "components/canvas.tsx",
      "components/sidebar.tsx",
      "components/editor-controls.tsx",
      "types/index.ts",
      "tests/**",
      "package.json",
      "tsconfig.json",
      "next.config.mjs",
      "biome.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useButtonType": "off",
        "noLabelWithoutControl": "off",
        "useSemanticElements": "off"
      },
      "performance": {
        "noImgElement": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
